# ---- canonical host + HTTPS (only on the live domain, so local XAMPP is untouched) ----
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.cantum-studio\.site$ [NC]
RewriteRule ^ https://cantum-studio.site%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^cantum-studio\.site$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://cantum-studio.site%{REQUEST_URI} [R=301,L]

# old .php URLs 301 to the clean ones (GET/HEAD only, live domain only; the file is still served internally below)
RewriteCond %{HTTP_HOST} ^cantum-studio\.site$ [NC]
RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/index\.php[\s?]
RewriteRule ^ https://cantum-studio.site/ [R=301,L]
RewriteCond %{HTTP_HOST} ^cantum-studio\.site$ [NC]
RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s/(.+?)\.php[\s?]
RewriteRule ^ https://cantum-studio.site/%2 [R=301,L]
</IfModule>

# ---- speed: compression + long caching for static files (CSS/JS carry ?v=, uploads have unique names) ----
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json application/ld+json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(webp|png|jpe?g|css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
Header set X-Content-Type-Options "nosniff"
# visitor demo uploads are short-lived: never cached by browsers or proxies
<If "%{REQUEST_URI} =~ m#/uploads/demo/#">
Header set Cache-Control "private, no-store"
Header unset Expires
</If>
</IfModule>

Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Indonesian version lives under /id/ (same scripts, language detected from the URL)
RewriteRule ^id/?$ index.php [L,QSA]
RewriteRule ^id/demo/?$ demo/index.php [L,QSA]
RewriteRule ^id/(about|contact|index-list|pricing|project)(\.php)?/?$ $1.php [L,QSA]

# internal code is never served over HTTP
RewriteRule ^inc/ - [F,L]

# clean URLs: /about → about.php, /admin/login → admin/login.php (real files and folders are left alone)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# never serve SQL dumps
<FilesMatch "\.(sql|sqlite)$">
Require all denied
</FilesMatch>
