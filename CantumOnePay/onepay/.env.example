# Cantum OnePay: contoh .env untuk PRODUKSI.
# Cara termudah: jangan salin manual, jalankan `php artisan onepay:install`; perintah itu mengisi berkas ini untukmu.
# Berkas .env tidak boleh masuk git dan tidak boleh bisa dibuka dari web (lihat docs/DEPLOY-HOSTINGER.md).

# ---- Aplikasi ----
APP_NAME="Cantum OnePay"
APP_ENV=production
# Diisi otomatis oleh `php artisan key:generate --force`. Jangan diubah setelah ada data: kunci API Kasera tersimpan terenkripsi dengan kunci ini.
APP_KEY=
# Harus false di produksi: kalau true, halaman galat bisa membocorkan isi konfigurasi.
APP_DEBUG=false
# Alamat situs resto, WAJIB https. Dipakai untuk tautan, return_url pembayaran, dan URL webhook.
APP_URL=https://pesan.contoh-resto.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---- Log ----
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---- Database MySQL (buat di hPanel > Databases > MySQL Databases) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---- Session, cache, antrean: file dan sync cukup untuk satu resto di shared hosting ----
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ---- Kasera Pay: akun milik resto sendiri ----
# kp_test_...  = sandbox (uang tidak sungguhan), selalu uji dulu dengan ini.
# kp_live_...  = produksi (uang sungguhan). Bisa juga diisi/diganti nanti di Pengaturan > Gateway.
KASERA_API_BASE_URL=https://pay.kasera.id/v1
KASERA_API_KEY=
KASERA_WEBHOOK_SECRET=

# ---- OnePay ----
# Batas waktu bayar sebelum pesanan kedaluwarsa (menit).
ONEPAY_ORDER_EXPIRY_MINUTES=15
# Backup harian disimpan berapa hari. Salin juga ke luar server secara berkala.
ONEPAY_BACKUP_KEEP_DAYS=14
# Isi false bila server melarang menjalankan program luar; dump lewat PHP dipakai sebagai gantinya.
ONEPAY_BACKUP_MYSQLDUMP=true
